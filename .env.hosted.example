# Copy to /opt/citizenship-platform/.env on the VM, set mode 600, and never commit it.
# IMAGE_TAG must be a full immutable Git commit SHA.
IMAGE_REGISTRY=ghcr.io/owner
IMAGE_TAG=0000000000000000000000000000000000000000
API_DOMAIN=api.tinkona.com
ROLLBACK_HOSTNAME=api.46-224-221-7.sslip.io
PUBLIC_SCHEME=https
CORS_ALLOWED_ORIGINS=https://api.tinkona.com,https://api.46-224-221-7.sslip.io
ADMIN_PORTAL_URL=https://api.tinkona.com
LEGACY_ADMIN_PORTAL_URL=https://api.46-224-221-7.sslip.io
# BOOTSTRAP_HTTP preserves temporary IP-based HTTP testing. Change to HTTPS_HOSTED
# only after DNS, certificates, and the public HTTPS gateway are working.
KEYCLOAK_SECURITY_MODE=HTTPS_HOSTED

# Pooled Neon EU JDBC endpoints for normal application traffic.
CONTENT_DATABASE_URL=jdbc:postgresql://EU-POOLER-HOST:5432/content?sslmode=verify-full
CONTENT_MIGRATION_DATABASE_URL=jdbc:postgresql://EU-DIRECT-HOST:5432/content?sslmode=verify-full
CONTENT_DATABASE_USERNAME=content_service
CONTENT_DATABASE_PASSWORD=CHANGE_ME
LEARNING_DATABASE_URL=jdbc:postgresql://EU-POOLER-HOST:5432/learning?sslmode=verify-full
LEARNING_MIGRATION_DATABASE_URL=jdbc:postgresql://EU-DIRECT-HOST:5432/learning?sslmode=verify-full
LEARNING_DATABASE_USERNAME=learning_service
LEARNING_DATABASE_PASSWORD=CHANGE_ME
AI_DATABASE_URL=jdbc:postgresql://EU-POOLER-HOST:5432/ai?sslmode=verify-full
AI_MIGRATION_DATABASE_URL=jdbc:postgresql://EU-DIRECT-HOST:5432/ai?sslmode=verify-full
AI_DATABASE_USERNAME=ai_service
AI_DATABASE_PASSWORD=CHANGE_ME
KEYCLOAK_DATABASE_URL=jdbc:postgresql://EU-POOLER-HOST:5432/identity?sslmode=verify-full
KEYCLOAK_DATABASE_USERNAME=identity_service
KEYCLOAK_DATABASE_PASSWORD=CHANGE_ME

LEARNING_INTERNAL_API_KEY=CHANGE_ME
AI_INTERNAL_API_KEY=CHANGE_ME
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

AI_PROVIDER=GEMINI
AI_GEMINI_API_KEY=CHANGE_ME
AI_GEMINI_MODEL=gemini-3.1-flash-lite
AI_BILLING_POLICY=FREE_ONLY
AI_ALLOW_PAID_FALLBACK=false
AI_REQUIRE_ZERO_COST_PROVIDER=true
AI_ALLOW_AUTOMATIC_BILLING_UPGRADE=false
AI_PROVIDER_PRIORITY=GEMINI,GROQ,OPENROUTER_FREE,OPENROUTER_PAID
GEMINI_ENABLED=true
GEMINI_FREE_ONLY=true
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_ONLY=true
GROQ_FREE_REQUEST_LIMIT=1000
GROQ_FREE_TOKEN_LIMIT=8000
CLOUDFLARE_WORKERS_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL=
CLOUDFLARE_WORKERS_AI_FREE_ONLY=true
CLOUDFLARE_DAILY_NEURON_LIMIT=10000
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_ALLOW_FREE_ROUTER=false
OPENROUTER_FREE_ONLY=true
OPENROUTER_ALLOW_PAID=false
OPENROUTER_BUDGET_USD=0
AI_USAGE_MODE=FREE_ONLY
AI_PAID_USAGE_ENABLED=false
AI_MONTHLY_SPEND_LIMIT_USD=0
AI_CONCURRENCY=2
AI_GEMINI_MAX_CONCURRENT_REQUESTS=1
AI_GEMINI_EXPECTED_BILLING_TIER=FREE
AI_GEMINI_PROJECT_LABEL=CHANGE_ME_NON_SECRET_LABEL
AI_GEMINI_INTERNAL_RPM_LIMIT=CHANGE_ME
AI_GEMINI_INTERNAL_TPM_LIMIT=CHANGE_ME
AI_GEMINI_INTERNAL_RPD_LIMIT=CHANGE_ME

EMAIL_PROVIDER=resend
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_EMAIL=CHANGE_ME
RESEND_FROM_NAME=Svea Study
RESEND_REPLY_TO_EMAIL=

# Social identity broker secrets (protected host values; never frontend env).
KEYCLOAK_GOOGLE_CLIENT_ID=CHANGE_ME
KEYCLOAK_GOOGLE_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_GOOGLE_ENABLED=false
IDENTITY_MANAGEMENT_ENABLED=false
IDENTITY_BFF_CLIENT_ID=identity-management-bff
IDENTITY_BFF_CLIENT_SECRET=CHANGE_ME
IDENTITY_RECENT_AUTHENTICATION_SECONDS=300
KEYCLOAK_APPLE_ENABLED=false
KEYCLOAK_APPLE_SERVICES_ID=CHANGE_ME
KEYCLOAK_APPLE_TEAM_ID=CHANGE_ME
KEYCLOAK_APPLE_KEY_ID=CHANGE_ME
KEYCLOAK_APPLE_PRIVATE_KEY_BASE64=CHANGE_ME
KEYCLOAK_SMTP_HOST=smtp.resend.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_USERNAME=resend
KEYCLOAK_SMTP_FROM=no-reply@tinkona.com
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Svea Study
KEYCLOAK_SMTP_REPLY_TO=support@tinkona.com
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME=Svea Study Support
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_CONFIGURED=false
KEYCLOAK_EMAIL_DMARC_STATUS=present

# Offsite logical backups. Direct endpoints only; do not use the pooler for pg_dump.
BACKUP_DATABASE_HOST=EU-DIRECT-HOST
BACKUP_DATABASE_PORT=5432
BACKUP_CONTENT_USERNAME=content_service
BACKUP_CONTENT_PASSWORD=CHANGE_ME
BACKUP_LEARNING_USERNAME=learning_service
BACKUP_LEARNING_PASSWORD=CHANGE_ME
BACKUP_AI_USERNAME=ai_service
BACKUP_AI_PASSWORD=CHANGE_ME
BACKUP_IDENTITY_USERNAME=identity_service
BACKUP_IDENTITY_PASSWORD=CHANGE_ME
BACKUP_S3_URI=s3://BUCKET/citizenship-platform
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_AGE_RECIPIENT=CHANGE_ME
