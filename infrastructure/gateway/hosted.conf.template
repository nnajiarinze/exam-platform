map $host $public_host_allowed {
  default 0;
  ${API_DOMAIN} 1;
  ${LEGACY_API_DOMAIN} 1;
  127.0.0.1 1;
  localhost 1;
}
map $host $primary_host_allowed {
  default 0;
  ${API_DOMAIN} 1;
  127.0.0.1 1;
  localhost 1;
}
map $host $legacy_host_allowed {
  default 0;
  ${LEGACY_API_DOMAIN} 1;
}

server {
  listen 8080 default_server;
  server_name ${API_DOMAIN} ${LEGACY_API_DOMAIN};
  server_tokens off;
  if ($public_host_allowed = 0) { return 421; }

  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location = /healthz {
    access_log off;
    default_type application/json;
    return 200 '{"status":"UP","mode":"hosted-https"}';
  }
  location / { return 308 https://$host$request_uri; }
}

server {
  listen 8443 ssl default_server;
  server_name ${API_DOMAIN};
  if ($primary_host_allowed = 0) { return 421; }
  ssl_certificate /tmp/nginx-certs/primary/fullchain.pem;
  ssl_certificate_key /tmp/nginx-certs/primary/privkey.pem;
  include /etc/nginx/snippets/hosted-tls.conf;
  include /etc/nginx/snippets/hosted-locations.conf;
}

server {
  listen 8443 ssl;
  server_name ${LEGACY_API_DOMAIN};
  if ($legacy_host_allowed = 0) { return 421; }
  ssl_certificate /tmp/nginx-certs/legacy/fullchain.pem;
  ssl_certificate_key /tmp/nginx-certs/legacy/privkey.pem;
  include /etc/nginx/snippets/hosted-tls.conf;
  include /etc/nginx/snippets/hosted-locations.conf;
}
