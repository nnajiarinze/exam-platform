{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development-local": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "LOCAL",
        "EXPO_PUBLIC_BUILD_KIND": "development",
        "EXPO_PUBLIC_EXAM_ID": "sverige-i-fokus-v1"
      }
    },
    "development-hosted": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "HOSTED",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.46-224-221-7.sslip.io",
        "EXPO_PUBLIC_BUILD_KIND": "internal",
        "EXPO_PUBLIC_EXAM_ID": "sverige-i-fokus-v1"
      }
    },
    "preview-hosted": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "HOSTED",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.46-224-221-7.sslip.io",
        "EXPO_PUBLIC_BUILD_KIND": "internal",
        "EXPO_PUBLIC_EXAM_ID": "sverige-i-fokus-v1"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "HOSTED",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.46-224-221-7.sslip.io",
        "EXPO_PUBLIC_BUILD_KIND": "production",
        "EXPO_PUBLIC_EXAM_ID": "sverige-i-fokus-v1"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  }
}
